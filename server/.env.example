# Server Configuration
PORT=5000
# Set to "production" on the host so cookies are marked Secure/SameSite=None.
NODE_ENV=development

# Stream Chat API Credentials (Required)
# Retrieve these from your GetStream.io Dashboard
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here
STREAM_APP_ID=your_stream_app_id_here

# Frontend URL for CORS (comma-separate extra origins in CORS_ORIGINS)
VERCEL_FRONTEND_URL=https://nrc-chat.vercel.app
# Optional extra allowed origins, e.g. Vercel preview deployments.
CORS_ORIGINS=

# PostgreSQL connection string (optional; falls back to local SQLite)
DATABASE_URL=

# Session / limits (optional overrides)
SESSION_SECRET=replace_with_a_long_random_string
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=railhub_session
BCRYPT_ROUNDS=12
# Test-only override for the local SQLite file; leave unset in normal use.
SQLITE_FILE=
RATE_LIMIT_ENABLED=true
# Leave empty to auto-select: postgres when DATABASE_URL is set, otherwise memory.
RATE_LIMIT_STORE=
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_ACCOUNT_MAX_FAILURES=6

# Number of reverse-proxy hops Express should trust when resolving req.ip.
TRUST_PROXY=1
